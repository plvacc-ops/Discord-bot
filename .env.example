# Bot token from the Discord Developer Portal (Bot -> Reset Token). NEVER put this file in a repository or on a web server.
DISCORD_TOKEN=

# ID of the Discord server - commands appear immediately (without it up to an hour)
GUILD_ID=875305430321086485

# Connection with the CoreOPS panel (Configuration -> Discord bot). Without these two values the bot runs on its own.
# COREOPS_URL = address of the portal without a trailing slash; COREOPS_TOKEN = the same as bot.api_token in config/config.php
COREOPS_URL=https://ops.plvacc.pl
COREOPS_TOKEN=

# Optional: role IDs. Values set in the CoreOPS panel take precedence.
BOARD_ROLE_ID=1394941236284227604
TRAINING_PILOT_ROLE_ID=1103329876053872780
EXAM_PILOT_ROLE_ID=1103330255760007229
