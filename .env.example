# Token bota z Discord Developer Portal (Bot -> Reset Token). NIGDY nie wrzucaj tego pliku do repozytorium ani na serwer WWW.
DISCORD_TOKEN=

# ID serwera Discord - komendy pojawiają się natychmiast (bez tego do godziny)
GUILD_ID=875305430321086485

# Połączenie z panelem CoreOPS (Configuration -> Discord bot). Bez tych dwóch wartości bot działa samodzielnie.
# COREOPS_URL = adres portalu bez końcowego ukośnika; COREOPS_TOKEN = to samo, co bot.api_token w config/config.php
COREOPS_URL=https://ops.plvacc.pl
COREOPS_TOKEN=

# Opcjonalnie: ID ról. Wartości ustawione w panelu CoreOPS mają pierwszeństwo.
